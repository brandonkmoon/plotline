{
  "name": "plotline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "partykit:dev": "npx partykit dev",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "db:push:dev": "node -e \"require('fs').readFileSync('.env.local','utf8').split('\\n').forEach(l=>{const m=l.match(/^([A-Z_]+)=(.+)$/);if(m)process.env[m[1]]=m[2].trim()});require('child_process').spawnSync('npx',['drizzle-kit','push'],{stdio:'inherit'})\""
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@vercel/og": "^0.11.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.10",
    "partykit": "^0.0.115",
    "partysocket": "^1.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
